// keel :: пример манифеста хоста.
//
// Скопируй в manifest/host.json и правь под себя:
//     cp manifest/host.example.json manifest/host.json
//
// Формат — JSON с комментариями: всё после # или // игнорируется,
// висячие запятые допускаются.
//
// ГЛАВНОЕ ПРАВИЛО: нет ключа — keel ничего не делает. Не «разумный
// дефолт», не «обычно так лучше», а буквально ничего. Всё, что должно
// произойти с хостом, написано здесь явно. Пустой манифест {} означает
// «не трогай ничего», и keel так и поступит.
//
// Справочник всех полей: docs/MANIFEST.md
{
  "host": {
    // Какие репозитории Proxmox использовать:
    //   no-subscription — бесплатный, для домашнего сервера
    //   enterprise      — платный, нужна подписка
    //   test            — тестовый, не для рабочих машин
    "repos": "no-subscription",

    // Ставить обновления при keel apply. Показывает список до установки.
    // Перезагрузку не делает — только предупреждает, если она нужна.
    "updates": true,

    // Перед закачкой keel меряет связь до репозитория и не начинает, если
    // она медленнее порога: на такой сети apt копит очередь закачек в
    // памяти и способен съесть хост целиком. "0" — не проверять.
    "updates_min_speed": "30K",

    // Копия конфигурации самого хоста: /etc/pve, сеть, хранилища, apt,
    // загрузчик плюс текстовый снимок состояния. Бэкапы виртуалок делает
    // vzdump, а вот хост не бэкапит никто — кроме этого.
    "config_backup": {
      "path": "/var/lib/vz/dump/keel-config",
      "keep": 7,
      "max_age_hours": 24
    }
  },

  // Хранилища. keel доводит content до описанного и умеет создать
  // отсутствующее хранилище типа dir. Ничего не удаляет; хранилища,
  // которых здесь нет, не трогает вовсе.
  //
  // snippets у local нужны для cloud-init: без них ВМ из облачных
  // образов не настроить.
  "storages": [
    { "name": "local", "content": ["iso", "vztmpl", "backup", "snippets"] }
  ],

  // Гости. Существующий гость с таким id НЕ ТРОГАЕТСЯ: keel сообщит,
  // чем он отличается от описания, и пройдёт мимо.
  "guests": [
    {
      "id": 100,
      "name": "haos",
      "profile": "haos",           // Home Assistant OS, ВМ из образа
      "cores": 2,
      "memory": 4096,              // МБ
      "disk": "32G",
      "storage": "local-lvm",
      "bridge": "vmbr0",
      "start_on_boot": true,
      "start": true                // запустить сразу после создания
    },

    {
      "id": 101,
      "name": "desktop",
      "profile": "desktop",

      // Чем закрыть роль «рабочий стол»:
      //   dri   — контейнер LXC с доступом к видеокарте хоста.
      //           Аппаратное ускорение и декодирование видео, хост не
      //           теряет консоль. Подключение по RDP. Основной путь.
      //   virgl — виртуальная машина с 3D через virtio-gl. Настоящая ВМ,
      //           но без аппаратного декодирования. Подключение по SPICE.
      "graphics": "dri",

      "cores": 4,
      "memory": 8192,
      "disk": "64G",
      "storage": "local-lvm",
      "bridge": "vmbr0",
      "start_on_boot": true,

      "cloudinit": {
        "user": "av",
        "ssh_key_from": "host"     // взять открытые ключи с хоста
      },

      // Добавляется к списку из профиля, а не заменяет его
      "packages": ["keepassxc", "remmina"]
    },

    {
      // Туннель Cloudflare: пускает твои сервисы наружу без открытых портов,
      // белого IP и проброса на роутере. Отдельный маленький контейнер.
      //
      // Токен в манифест не пишется никогда: keel спросит его при создании и
      // положит в /root/keel/secrets/cloudflared.txt. Посмотреть потом —
      // keel token. Сам туннель и маршруты к сервисам настраиваются в панели
      // Cloudflare, это не автоматизируется — см. docs/40-cloudflared.md.
      "id": 102,
      "name": "tunnel",
      "profile": "cloudflared",
      "storage": "local-lvm",
      "bridge": "vmbr0",
      "start_on_boot": true
    }
  ],

  // Расписание резервного копирования гостей.
  // Формат времени — календарные события Proxmox: "02:00", "mon..fri 22:30".
  // Задание помечается комментарием keel; чужие задания не трогаются.
  "backup": {
    "schedule": "02:00",
    "storage": "local",
    "mode": "snapshot",
    "guests": [100, 101, 102],
    "keep_last": 3,
    "compress": "zstd"
  }
}
