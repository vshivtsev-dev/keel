// Туннель Cloudflare в отдельном контейнере.
//
// cloudflared соединяется с Cloudflare изнутри наружу и пробрасывает твои
// сервисы в интернет без открытых портов, белого IP и проброса на роутере.
//
// Почему в своём контейнере, а не на хосте: хост остаётся чистым, а туннель
// становится обычным гостем keel — описан в манифесте и поднимается сам при
// сборке хоста с нуля. Ему нужен только исходящий доступ в сеть.
//
// Токен в манифест не попадает никогда. keel спросит его при создании и
// положит в /root/keel/secrets/cloudflared.txt с правами 0600.
{
  "kind": "lxc",
  "title": "Туннель Cloudflare (cloudflared)",

  "template": {
    "pattern": "debian-13-standard",
    "storage": "local"
  },

  // Входить сюда некуда: ни рабочего стола, ни пользователя не нужно
  "needs_password": false,

  // А вот без токена туннель бессмысленен, и придумать его keel не может
  "needs_token": true,
  "token_file": "cloudflared",
  "token_hint": "Токен туннеля из панели Cloudflare:\nZero Trust → Networks → Tunnels → твой туннель → Configure.\nДлинная строка вида eyJhIjoi…\n\nСохраню в /root/keel/secrets/cloudflared.txt, в манифест он не попадёт.",
  "token_command": "cloudflared service install KEEL_TOKEN",

  "ready_hint": "Проверь в панели Cloudflare: туннель должен стать зелёным.",

  // Туннелю хватает минимума: это одна небольшая служба
  "defaults": { "cores": 1, "memory": 512, "disk": "4G" },

  "lxc": {
    "unprivileged": true,
    "ostype": "debian",
    "swap": 256
  },

  "packages": ["curl", "ca-certificates"],

  // Ставим официальный .deb от Cloudflare, а не их apt-репозиторий: тот
  // раскладывается по кодовым именам Debian, и на свежем выпуске его может
  // ещё не быть. Пакет — статический бинарник, зависимостей почти нет.
  // Обновление: пересоздать контейнер или повторить эти же три строки.
  "runcmd": [
    "curl -fsSL -o /tmp/cloudflared.deb https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb",
    "dpkg -i /tmp/cloudflared.deb || apt-get install -y -f",
    "rm -f /tmp/cloudflared.deb"
  ]
}
