// Рабочий стол в виртуальной машине, вариант B: 3D через virtio-gl.
//
// Видеокарта хоста не пробрасывается — ускорение идёт через драйвер хоста.
// Хост не теряет консоль, откат мгновенный. Аппаратного декодирования
// видео здесь нет, тяжёлые ролики упрутся в процессор.
//
// Подключаться нужно SPICE-клиентом (virt-viewer): через веб-консоль
// не будет ни звука, ни ускорения.
{
  "kind": "vm-cloudinit",
  "title": "Рабочий стол (ВМ, virtio-gl)",

  "image": {
    "url": "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img",
    "compressed": "none"
  },

  // Рабочему столу нужен пароль для входа: keel спросит его при
  // создании, а в неинтерактивном режиме сгенерирует и сохранит
  // в /var/lib/keel/secrets/. В манифесте паролей нет и не будет.
  "needs_password": true,

  "defaults": { "cores": 4, "memory": 8192, "disk": "64G" },

  "vm": {
    "machine": "q35",
    "bios": "seabios",
    "scsihw": "virtio-scsi-single",
    "ostype": "l26",
    "agent": true,
    "cpu": "host",
    "vga": "virtio-gl",
    // Без звукового устройства на стороне Proxmox гость не увидит
    // звуковую карту, сколько пакетов внутрь ни ставь
    "audio": "ich9-intel-hda,driver=spice",
    "serial": false
  },

  "packages": [
    "xfce4", "xfce4-goodies", "dbus-x11",
    "lightdm",
    "spice-vdagent",
    "pipewire", "pipewire-pulse", "wireplumber",
    "firefox", "vlc",
    "mesa-utils",
    "qemu-guest-agent"
  ],

  "runcmd": [
    "systemctl set-default graphical.target",
    "systemctl enable --now spice-vdagentd || true"
  ]
}
