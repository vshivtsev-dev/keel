// Home Assistant OS — своя операционная система, не cloud-init.
// Ставится из готового образа qcow2 в виртуальную машину: это
// единственный способ, который поддерживают разработчики Home Assistant.
{
  "kind": "vm-image",
  "title": "Home Assistant OS",

  "image": {
    // latest — версия определится через GitHub API при применении.
    // Если API недоступен, берётся fallback_version.
    "github_repo": "home-assistant/operating-system",
    "version": "latest",

    // Имя файла берётся из ответа GitHub по этому образцу, а не собирается
    // из шаблона: наверху могут переименовать файл или не выложить его для
    // очередной версии — так уже было с 18.3, и keel уткнулся в 404.
    "asset_pattern": "^haos_ova-.*[.]qcow2[.]xz$",

    // Запасные пути, если API недоступен: сначала шаблон с найденной
    // версией, потом он же с fallback_version.
    "fallback_version": "18.2",
    "url_template": "https://github.com/home-assistant/operating-system/releases/download/${version}/haos_ova-${version}.qcow2.xz",
    "compressed": "xz"
  },

  "defaults": {
    "cores": 2,
    "memory": 4096,
    "disk": "32G"
  },

  "vm": {
    // q35 + UEFI — так HAOS ожидает себя видеть
    "machine": "q35",
    "bios": "ovmf",
    "efidisk": true,
    "pre_enrolled_keys": false,
    "scsihw": "virtio-scsi-single",
    "ostype": "l26",
    "agent": false,
    "cpu": "host"
  }
}
