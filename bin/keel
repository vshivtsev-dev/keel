#!/usr/bin/env bash
#
# keel — сборка и восстановление хоста Proxmox VE.
#
#   keel              открыть меню
#   keel plan         показать, что изменится (ничего не трогает)
#   keel apply        показать план, спросить один раз и применить
#   keel doctor       отчёт о состоянии хоста
#
# Полная справка: keel help

set -Eeuo pipefail

KEEL_VERSION="0.2.0"

# Каталог проекта: работает и при запуске из репозитория, и через симлинк
_self=${BASH_SOURCE[0]}
if command -v readlink >/dev/null 2>&1; then
  _self=$(readlink -f "$_self" 2>/dev/null || printf '%s' "$_self")
fi
KEEL_ROOT=$(cd "$(dirname "$_self")/.." && pwd)
export KEEL_ROOT KEEL_VERSION

# shellcheck source=../lib/core.sh
source "${KEEL_ROOT}/lib/core.sh"
# shellcheck source=../lib/ui.sh
source "${KEEL_ROOT}/lib/ui.sh"
# shellcheck source=../lib/config.sh
source "${KEEL_ROOT}/lib/config.sh"
# shellcheck source=../lib/state.sh
source "${KEEL_ROOT}/lib/state.sh"
# shellcheck source=../lib/pve.sh
source "${KEEL_ROOT}/lib/pve.sh"
# shellcheck source=../lib/guests.sh
source "${KEEL_ROOT}/lib/guests.sh"
# shellcheck source=../lib/gpu.sh
source "${KEEL_ROOT}/lib/gpu.sh"
# shellcheck source=../lib/modules.sh
source "${KEEL_ROOT}/lib/modules.sh"
# shellcheck source=../lib/doctor.sh
source "${KEEL_ROOT}/lib/doctor.sh"
# shellcheck source=../lib/external.sh
source "${KEEL_ROOT}/lib/external.sh"

# Манифест лежит рядом с остальным твоим — в KEEL_HOME, а не среди кода:
# обновление keel перезаписывает app/ целиком и до манифеста не дотягивается.
KEEL_MANIFEST="${KEEL_MANIFEST:-${KEEL_HOME}/host.json}"
KEEL_ONLY=""

usage() {
  cat <<'EOF'
keel — сборка и восстановление хоста Proxmox VE.

Использование:
  keel [флаги] [команда]

Команды:
  menu        интерактивное меню (по умолчанию)
  plan        показать список изменений, ничего не выполняя
  apply       показать план, спросить один раз и применить
  verify      проверить, соответствует ли хост манифесту
  doctor      отчёт о состоянии хоста и о видеокарте
  validate    проверить манифест на ошибки
  backup      снять копию конфигурации хоста прямо сейчас
  gpu revert  откатить проброс видеокарты
  password ID показать пароль, сгенерированный для гостя
  token [ИМЯ] показать сохранённый токен (по умолчанию cloudflared)
  guests      список гостей из манифеста и их состояние
  external    внешние инструменты (community-scripts)
  modules     список модулей
  logs        показать последний лог
  version     версия
  help        эта справка

Флаги:
  --step           спрашивать перед каждым изменением по отдельности
  --yes            не спрашивать вообще
                   (только после того, как посмотрел plan)
  --dry-run        ничего не выполнять, только показывать команды
  --only ID        работать с одним модулем, например: --only host/10-repos
  --guest ID       только эти гости, через запятую: --guest 201 или 200,201
                   (в меню то же самое — галочками)
  --manifest PATH  другой файл манифеста
  --plain          без псевдографики, обычным текстом

Порядок, который экономит нервы:
  keel doctor  →  keel plan  →  keel apply
EOF
}

parse_args() {
  local positional=()
  while (( $# )); do
    # shellcheck disable=SC2034  # KEEL_UI читается в lib/ui.sh
    case "$1" in
      --yes|-y)   KEEL_MODE="yes" ;;
      --step)     KEEL_MODE="step" ;;
      --dry-run)  KEEL_MODE="dry" ;;
      --plain)    KEEL_UI="plain" ;;
      --only)     shift; KEEL_ONLY=${1:-} ;;
      --guest)    shift; KEEL_GUESTS_ONLY="${KEEL_GUESTS_ONLY:+${KEEL_GUESTS_ONLY},}${1:-}" ;;
      --manifest) shift; KEEL_MANIFEST=${1:-} ;;
      -h|--help)  usage; exit 0 ;;
      --*)        die "Неизвестный флаг: $1 (см. keel help)" ;;
      *)          positional+=("$1") ;;
    esac
    shift || true
  done
  KEEL_CMD=${positional[0]:-menu}
  KEEL_ARGV=("${positional[@]}")
}

# Применять что-либо к машине, которая не является хостом Proxmox, почти
# наверняка ошибка. Обойти можно осознанно: KEEL_ALLOW_NON_PVE=1.
need_pve() {
  [[ -n "$KEEL_FS_ROOT" ]] && return 0
  [[ "${KEEL_ALLOW_NON_PVE:-}" == "1" ]] && return 0
  pve_is_host && return 0
  die "Это не хост Proxmox VE. Если уверен — KEEL_ALLOW_NON_PVE=1 keel apply"
}

# Проброс видеокарты живёт отдельной командой: откат должен быть доступен
# даже когда манифест уже поправлен и модуль о пробросе больше не знает.
gpu_command() {
  case "${1:-}" in
    revert) need_root; gpu_revert ;;
    status)
      if [[ -f "$(gpu_state_file)" ]]; then cat "$(gpu_state_file)"
      else info "Записи о пробросе нет — видеокарта не отдавалась."; fi
      ;;
    *) die "keel gpu revert — откатить проброс; keel gpu status — что записано" ;;
  esac
}

# Пароли гостей в манифесте не хранятся — только здесь, и только для root
show_password() {
  local id=$1
  local file="${KEEL_SECRETS_DIR}/${id}.txt"
  [[ -n "$id" ]] || die "Укажи id гостя: keel password 102"
  [[ -f "$file" ]] || die "Для гостя ${id} пароль не сохранён (${file} нет)."
  cat "$file"
}

# Токены внешних сервисов лежат там же, где пароли, и так же только для root
show_token() {
  local name=${1:-cloudflared}
  local file="${KEEL_SECRETS_DIR}/${name}.txt"
  [[ -f "$file" ]] || die "Токен «${name}» не сохранён (${file} нет).
Положи его туда одной строкой или дай keel спросить при применении."
  cat "$file"
}

show_logs() {
  if [[ -n "${KEEL_LOG_FILE:-}" && -f "$KEEL_LOG_FILE" ]]; then
    ui_msgbox "Лог текущего запуска" "$(tail -n 200 "$KEEL_LOG_FILE")"
  else
    ui_msgbox "Логи" "Логов пока нет."
  fi
}

# Строки для списка гостей одного рода: id, имя, чем будет, состояние.
# Печатает "id<TAB>подпись<TAB>on|off"; пусто — таких гостей в манифесте нет.
guest_rows() {
  local want=$1 n i id name kind title state flag
  n=$(guests_count)
  for (( i = 0; i < n; i++ )); do
    id=$(config_get "guests.${i}.id")
    [[ -n "$id" ]] || continue
    # Профиль загружаем здесь, а не через $(guest_kind): подстановка —
    # это подоболочка, и загруженный в ней профиль до нас не доживёт
    guest_prepare "$i" >/dev/null 2>&1 || continue
    case "$(prof_get kind "")" in
      lxc)  kind=lxc ;;
      vm-*) kind=vm ;;
      *)    kind=неизвестно ;;
    esac
    [[ "$kind" == "$want" ]] || continue
    name=$(config_get "guests.${i}.name" "без имени")
    title=$(prof_get title "$(guest_profile_name "$i")")
    if guest_exists "$id"; then
      state="уже есть, не трону"; flag="off"
    else
      state="нет на хосте"; flag="on"
    fi
    printf '%s\t%s  %s  —  %s\t%s\n' "$id" "$(pad "$name" 16)" "$title" "$state" "$flag"
  done
}

# Экран выбора гостей одного рода. Машины и контейнеры разведены нарочно:
# в Proxmox это разные сущности с разными командами и разной ценой ошибки,
# и в одном списке они выглядят обманчиво одинаково.
pick_guests() {
  local kind=$1 title=$2
  local args=() id label flag
  while IFS=$'\t' read -r id label flag; do
    [[ -n "$id" ]] || continue
    args+=("$id" "${id}  ${label}" "$flag")
  done < <(guest_rows "$kind")

  if (( ${#args[@]} == 0 )); then
    ui_msgbox "$title" "В манифесте нет ни одного гостя этого рода.

Добавь его в ${KEEL_MANIFEST} — и он появится здесь."
    return 0
  fi

  local chosen
  chosen=$(ui_checklist "$title" "Отметь, кого поставить:" "${args[@]}")
  [[ -n "$chosen" ]] || return 0

  local picked=() one
  for one in $chosen; do
    one=${one//\"/}
    # Не «&&» последней строкой тела цикла: при пустом значении вся конструкция
    # возвращает единицу, а под set -e это обрывает выполнение
    if [[ -n "$one" ]]; then picked+=("$one"); fi
  done
  (( ${#picked[@]} )) || return 0

  KEEL_GUESTS_ONLY=$(IFS=,; printf '%s' "${picked[*]}")
  modules_apply guests/50-guests
  KEEL_GUESTS_ONLY=""
}

# Тот же список, но печатью — когда меню недоступно или просто посмотреть
show_guests() {
  local kind label id row flag
  for kind in vm lxc; do
    case "$kind" in
      vm)  label="Виртуальные машины" ;;
      lxc) label="Контейнеры LXC" ;;
    esac
    head1 "$label"
    local found=0
    while IFS=$'\t' read -r id row flag; do
      [[ -n "$id" ]] || continue
      printf '  %s  %s\n' "$id" "$row"
      found=1
    done < <(guest_rows "$kind")
    (( found )) || note "В манифесте таких нет."
  done
}

pick_modules() {
  local args=() id title
  while IFS=$'\t' read -r id title; do
    [[ -n "$id" ]] || continue
    args+=("$id" "${id}  —  ${title}" "off")
  done < <(modules_list_ids)
  (( ${#args[@]} )) || { ui_msgbox "Модули" "Модулей пока нет."; return 0; }

  local chosen
  chosen=$(ui_checklist "Выбор модулей" "Отметь, что применить:" "${args[@]}")
  [[ -n "$chosen" ]] || return 0

  local m
  for m in $chosen; do
    m=${m//\"/}
    modules_apply "$m"
  done
}

menu_loop() {
  while true; do
    local choice
    # Нумерация пунктов здесь не пишется руками: в окне newt по списку ходят
    # стрелками, а в текстовом режиме ui_menu нумерует сам. Раньше номера
    # стояли в подписях и в текстовом режиме шли вторым столбцом цифр.
    choice=$(ui_menu "keel ${KEEL_VERSION}" \
      "Хост: $(hostname 2>/dev/null || echo '?')    Режим: $(keel_mode_title)" \
      plan    "Показать план — ничего не меняет" \
      apply   "Применить всё из манифеста" \
      pick    "Выбрать отдельные модули" \
      vms     "Виртуальные машины — поставить по одной" \
      cts     "Контейнеры LXC — поставить по одному" \
      verify  "Проверить соответствие манифесту" \
      doctor  "Состояние хоста и видеокарты" \
      backup  "Снять копию конфигурации хоста" \
      extern  "Внешние инструменты (не часть манифеста)" \
      logs    "Логи последнего запуска" \
      quit    "Выход")

    case "$choice" in
      plan)   modules_plan "$KEEL_ONLY";   _pause ;;
      apply)  modules_apply "$KEEL_ONLY";  _pause ;;
      pick)   pick_modules;                _pause ;;
      vms)    need_root; pick_guests vm  "Виртуальные машины";  _pause ;;
      cts)    need_root; pick_guests lxc "Контейнеры LXC";      _pause ;;
      verify) modules_verify "$KEEL_ONLY"; _pause ;;
      doctor) doctor_run;                  _pause ;;
      backup) need_root; modules_apply host/90-config-backup; _pause ;;
      extern) need_root; external_menu;     _pause ;;
      logs)   show_logs ;;
      quit|"") return 0 ;;
    esac
  done
}

_pause() {
  if ui_has_whiptail; then
    printf '\n'
    read -r -n1 -p "Нажми любую клавишу, чтобы вернуться в меню..." _ </dev/tty || true
    printf '\n'
  fi
}

main() {
  parse_args "$@"
  core_init
  state_init
  config_load "$KEEL_MANIFEST"

  # Опечатка в номере не должна выглядеть как «делать нечего»
  if [[ -n "$KEEL_GUESTS_ONLY" ]]; then
    local want have=() n i id
    n=$(guests_count)
    for (( i = 0; i < n; i++ )); do have+=("$(config_get "guests.${i}.id")"); done
    for want in ${KEEL_GUESTS_ONLY//,/ }; do
      id=" ${have[*]} "
      [[ "$id" == *" ${want} "* ]] && continue
      err "Гостя ${want} нет в манифесте."
      note "Есть: ${have[*]:-(ни одного)}"
      exit 1
    done
  fi

  case "$KEEL_CMD" in
    menu)     menu_loop ;;
    plan)     modules_plan "$KEEL_ONLY" ;;
    apply)    need_root; need_pve; modules_apply "$KEEL_ONLY" ;;
    verify)   modules_verify "$KEEL_ONLY" ;;
    doctor)   doctor_run ;;
    validate)
      if config_validate; then ok "Манифест в порядке."; else die "В манифесте есть ошибки."; fi ;;
    backup)   need_root; need_pve; modules_apply host/90-config-backup ;;
    gpu)      gpu_command "${KEEL_ARGV[1]:-}" ;;
    password) show_password "${KEEL_ARGV[1]:-}" ;;
    token)    show_token "${KEEL_ARGV[1]:-}" ;;
    guests)   show_guests ;;
    external) need_root; external_menu ;;
    modules)  modules_list_ids | column -t -s $'\t' 2>/dev/null || modules_list_ids ;;
    logs)     if [[ -f "$KEEL_LOG_FILE" ]]; then cat "$KEEL_LOG_FILE"; fi ;;
    version)  printf 'keel %s\n' "$KEEL_VERSION" ;;
    help)     usage ;;
    *)        die "Неизвестная команда: ${KEEL_CMD} (см. keel help)" ;;
  esac
}

main "$@"
