// Debian 13 (Trixie), облачный образ + cloud-init.
// Обычный сервер: без графики, вход по ключу, настраивается до первого старта.
{
  "kind": "vm-cloudinit",
  "title": "Debian 13 (сервер)",

  "image": {
    "url": "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2",
    "compressed": "none"
  },

  "defaults": {
    "cores": 2,
    "memory": 2048,
    "disk": "20G"
  },

  "vm": {
    "machine": "q35",
    "bios": "seabios",
    "scsihw": "virtio-scsi-single",
    "ostype": "l26",
    "agent": true,
    "cpu": "host",
    "serial": true
  },

  "packages": ["qemu-guest-agent"]
}
